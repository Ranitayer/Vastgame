{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vastgame",
  "version": "0.1.0",
  "identifier": "io.vastgame.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Vastgame",
      "width": 1080,
      "height": 720,
      "minWidth": 600,
      "minHeight": 600,
      "center": true,
      "decorations": false,
      "transparent": true,
      "backgroundColor": "#00000000"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
